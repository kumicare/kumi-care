# Shell environment template. Not automatically loaded. Never commit real values.
MQTT_HOST=mqtt.example.com
MQTT_PORT=8883
MQTT_USERNAME=door-sensor
MQTT_PASSWORD=
# Optional private CA certificate path; otherwise system trust roots.
MQTT_CA_CERT=
CARE_HOME_ID=main
CARE_DEVICE_ID=front-door
# Empty prompts securely at startup.
BLE_BINDKEY=

# Durable outbox: keep the same path across restarts; use one bridge process.
CARE_OUTBOX_PATH=.local/outbox.sqlite3
